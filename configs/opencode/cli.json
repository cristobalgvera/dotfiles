{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "nightowl",
    "mode": "dark"
  },
  "keybinds": {
    "session.page.up": "ctrl+u",
    "session.page.down": "ctrl+d"
  },
  "plugins": [
    "vimcode@git+https://github.com/oribarilan/vimcode.git#v0.19.2"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "low",
    "permissions": "prompt",
    "submit_scroll": "bottom",
    "markdown": "rendered",
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "indicators": "status"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": false
  },
  "prompt": {
    "editor": true
  }
}
